{
	"name": "convocept",
	"version": "1.0.0-dev",
	"description": "The fastest comment system for WordPress.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "npm run build:front && npm run build:admin && npm run build:blocks",
		"build:front": "node bin/build-front.mjs",
		"build:admin": "wp-scripts build assets/src/admin/index.js --output-path=assets/dist/admin",
		"start": "node bin/build-front.mjs --watch",
		"size": "size-limit",
		"lint": "npm run lint:js && npm run lint:css && npm run format:check",
		"lint:js": "wp-scripts lint-js assets/src tests/e2e bin",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.css\"",
		"format": "wp-scripts format assets/src tests/e2e bin",
		"format:check": "wp-scripts format --check assets/src tests/e2e bin",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/convocept composer test",
		"test:e2e": "wp-scripts test-playwright",
		"wporg:assets": "wp-scripts test-playwright --config playwright.wporg.config.js",
		"release": "bash bin/build-zip.sh",
		"build:blocks": "wp-scripts build --webpack-src-dir=assets/src/blocks --output-path=assets/dist/blocks"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0",
		"@size-limit/file": "^14.0.1",
		"@wordpress/babel-plugin-import-jsx-pragma": "^5.56.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/scripts": "^36.0.0",
		"esbuild": "^0.28.2",
		"size-limit": "^14.0.1"
	}
}
